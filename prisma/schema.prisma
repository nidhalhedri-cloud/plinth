// Developer CRM — multi-tenant SaaS for Dubai real-estate DEVELOPERS.
// Every tenant-scoped table carries `companyId`; isolation is enforced in src/lib/tenant.ts
// (a Prisma Client extension that injects/validates companyId on every query) — see §5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── tenancy & people ───────────────────────────

enum Role {
  PLATFORM_ADMIN // cross-tenant (no company)
  COMPANY_ADMIN  // one developer company
  RM             // relationship / sales manager
}

model Company {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  tradeLicenseUrl     String?
  logoUrl             String?
  brandColor          String?  @default("#2563eb")
  primaryContactName  String?
  primaryContactEmail String?
  // Developer-authored terms shown on the generated Booking Form / SPA documents.
  bookingTerms        String?  @db.Text
  spaTerms            String?  @db.Text
  // SMTP for automated buyer emails (the developer's own mailbox) + payment-reminder settings.
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPass     String?
  fromEmail    String?
  fromName     String?
  remindersEnabled   Boolean @default(false)
  reminderDaysBefore Int     @default(7)
  subscriptionStatus  String   @default("trialing")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users        User[]
  invites      Invite[]
  brokerages   Brokerage[]
  projects     Project[]
  layouts      Layout[]
  units        Unit[]
  paymentPlans PaymentPlan[]
  feeSettings  FeeSetting[]
  offers       Offer[]
  waSendLogs   WhatsappSendLog[]
  assets       Asset[]
  payments     Payment[]
  eois         Eoi[]
  clients      Client[]
}

// A buyer/client of the developer — their contact + ID details, the units (deals) they hold, and
// their uploaded documents (passport, Emirates ID, signed SPA, cheques, …).
model Client {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  idType    String? // id (Emirates ID) | passport
  idNumber  String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  offers    Offer[]
  documents Asset[]

  @@index([companyId])
}

// Binary storage in Postgres — layout floor plans, company logos, generated offer PDFs. Keeps the
// greenfield app self-contained (no S3 to provision); swap for object storage later behind the same
// /api/assets/[id] URL. Served through that route with the stored mime type.
model Asset {
  id        String   @id @default(cuid())
  companyId String
  kind      String   @default("layout") // layout | logo | offer_pdf | client_doc | payment_proof
  mime      String
  bytes     Bytes
  size      Int
  clientId  String? // set for client_doc uploads
  label     String? // e.g. "Passport", "Signed SPA"
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clientId])
}

model User {
  id           String   @id @default(cuid())
  companyId    String?  // null only for PLATFORM_ADMIN
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String?
  role         Role     @default(RM)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company        Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitesSent    Invite[]         @relation("InvitedBy")
  brokerageLinks BrokerageLink[]
  offers         Offer[]
  waSession      WhatsappSession?
  waSendLogs     WhatsappSendLog[]

  @@index([companyId])
}

model Invite {
  id          String    @id @default(cuid())
  companyId   String
  email       String
  role        Role      @default(RM)
  token       String    @unique
  invitedById String?
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([email])
}

// ─────────────────────────── brokerages & WhatsApp groups ───────────────────────────

model Brokerage {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  reraNumber    String?
  contactPerson String?
  phone         String?
  // Default commission the developer pays this agency, and whether the RERA agency agreement is registered.
  commissionRate      Decimal? @db.Decimal(6, 3)
  agreementRegistered Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  links   BrokerageLink[]
  offers  Offer[]

  @@index([companyId])
}

// One brokerage may be linked to several RMs, each with their own WhatsApp group.
model BrokerageLink {
  id                String   @id @default(cuid())
  companyId         String
  brokerageId       String
  rmUserId          String
  whatsappGroupJid  String? // Baileys group JID (…@g.us) — stored instead of a phone number
  whatsappGroupName String?
  createdAt         DateTime @default(now())

  brokerage Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  rm        User      @relation(fields: [rmUserId], references: [id], onDelete: Cascade)

  @@unique([brokerageId, rmUserId])
  @@index([companyId])
}

// ─────────────────────────── projects, layouts, inventory ───────────────────────────

model Project {
  id              String    @id @default(cuid())
  companyId       String
  name            String
  location        String?
  handoverDefault String?
  // The anchor date for payment scheduling: from the offer/booking date up to handover, milestones
  // get real calendar dates (and are auto-compressed if the window is short).
  handoverDate    DateTime?
  // RERA project escrow account — every buyer installment must be paid into it (Law No. 8 of 2007).
  escrowBank      String?
  escrowAccountNo String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  layouts Layout[]
  units   Unit[]
  eois    Eoi[]

  @@unique([companyId, name])
  @@index([companyId])
}

// A typology (e.g. "1BR-A") — one floor-plan image per code per project, auto-matched to units.
model Layout {
  id           String   @id @default(cuid())
  companyId    String
  projectId    String
  code         String
  bedrooms     Int?
  bathrooms    Int?
  sizeMin      Int?
  sizeMax      Int?
  imageUrl     String?
  imageVersion Int      @default(1) // bumped on replace; offers snapshot the version they used
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, code])
  @@index([companyId])
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  BLOCKED
}

model Unit {
  id            String     @id @default(cuid())
  companyId     String
  projectId     String
  unitNumber    String
  layoutCode    String
  floor         Int?
  sizeSqft      Int?
  view          String?
  priceAed      Decimal    @db.Decimal(14, 2)
  paymentPlanId String?
  handover      String?
  status        UnitStatus @default(AVAILABLE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  paymentPlan PaymentPlan? @relation(fields: [paymentPlanId], references: [id], onDelete: SetNull)
  offers      Offer[]

  @@unique([projectId, unitNumber])
  @@index([companyId])
  @@index([companyId, status])
}

// ─────────────────────────── payment plans & fees ───────────────────────────

model PaymentPlan {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  isPreset    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  milestones PaymentMilestone[]
  units      Unit[]

  @@unique([companyId, name])
  @@index([companyId])
}

enum MilestoneTrigger {
  ON_BOOKING
  ON_OQOOD // DLD registration
  CONSTRUCTION_PCT // triggerValue = percent complete
  ON_HANDOVER
  POST_HANDOVER // triggerValue = months after handover
  FIXED_DATE // triggerValue = ISO date
}

model PaymentMilestone {
  id            String           @id @default(cuid())
  companyId     String
  paymentPlanId String
  order         Int
  label         String
  percent       Decimal?         @db.Decimal(6, 3) // % of price, OR
  fixedAmount   Decimal?         @db.Decimal(14, 2) // a fixed AED amount
  trigger       MilestoneTrigger @default(ON_BOOKING)
  triggerValue  String? // percent / months / ISO date depending on trigger
  createdAt     DateTime         @default(now())

  paymentPlan PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([paymentPlanId])
}

enum FeeKind {
  PERCENT
  FIXED
}

enum FeePayer {
  BUYER
  SELLER
  SPLIT
}

// Company-level fee lines (DLD 4%, Oqood, trustee, NOC, custom). projectId set = per-project override.
model FeeSetting {
  id        String   @id @default(cuid())
  companyId String
  projectId String? // null = company default
  label     String
  kind      FeeKind  @default(FIXED)
  value     Decimal  @db.Decimal(14, 3) // percent (e.g. 4) or AED amount
  payer     FeePayer @default(BUYER)
  taxable   Boolean  @default(false)
  sortOrder Int      @default(0)
  isSystem  Boolean  @default(false) // seeded DLD/Oqood defaults
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─────────────────────────── offers / reservation forms (= the deal record) ───────────────────────────

enum OfferStatus {
  DRAFT
  SENT
  VIEWED
  RESERVED
  SPA_SIGNED
  SOLD
  DROPPED
}

model Offer {
  id           String      @id @default(cuid())
  companyId    String
  unitId       String
  brokerageId  String?
  rmUserId     String
  publicToken  String      @unique // open, trackable web-link
  status       OfferStatus @default(DRAFT)
  priceAed     Decimal     @db.Decimal(14, 2)
  discountAed  Decimal?    @db.Decimal(14, 2)
  note         String?
  // Full computed offer at finalize time (unit specs, layout image + version, schedule, fees) so a
  // later template/fee/layout change never mutates an already-sent offer.
  snapshot     Json?
  // Buyer details captured at booking — needed on the Booking Form and SPA.
  clientName     String?
  clientEmail    String?
  clientAddress  String?
  clientIdType   String? // 'id' (Emirates ID) | 'passport'
  clientIdNumber String?
  clientId       String? // linked Client record (created/linked at booking)
  // When the client starts paying — anchors the booking/SPA schedule (may differ from the offer date).
  bookingStartDate    DateTime?
  paymentProofAssetId String? // uploaded proof of the booking payment
  // Schedule recomputed at booking from bookingStartDate, frozen onto the booking/SPA documents.
  bookingSnapshot     Json?
  // Broker commission on this deal (developer pays the broker). Rate overrides the brokerage default.
  commissionRate   Decimal? @db.Decimal(6, 3)
  commissionStatus String   @default("accrued") // accrued | invoiced | paid
  // DLD/Oqood registration of the SPA (must be registered within the DLD deadline after signing).
  oqoodStatus String    @default("pending") // pending | registered | title_deed
  oqoodRef    String?
  oqoodDate   DateTime?
  // Handover lifecycle: completion notice → snagging → final payment/NOC → title deed.
  handoverStatus String  @default("not_started") // not_started | completion_notice | snagging | noc | title_deed
  titleDeedRef   String?
  pdfUrl       String?
  viewCount    Int         @default(0)
  firstViewedAt DateTime?
  sentAt       DateTime?
  reservedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  brokerage Brokerage? @relation(fields: [brokerageId], references: [id], onDelete: SetNull)
  rm        User       @relation(fields: [rmUserId], references: [id], onDelete: Cascade)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  sendLogs  WhatsappSendLog[]
  payments  Payment[]

  @@index([companyId])
  @@index([companyId, status])
}

// ─────────────────────────── WhatsApp (Baileys) — Phase 6 ───────────────────────────

model WhatsappSession {
  id          String   @id @default(cuid())
  rmUserId    String   @unique
  companyId   String
  status      String   @default("disconnected")
  authState   Json? // Baileys multi-file auth state, persisted so RMs don't re-scan each deploy
  phoneNumber String?
  updatedAt   DateTime @updatedAt

  rm User @relation(fields: [rmUserId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model WhatsappSendLog {
  id          String   @id @default(cuid())
  companyId   String
  rmUserId    String
  brokerageId String?
  offerId     String?
  groupJid    String
  caption     String?
  kind        String   @default("PDF")
  status      String   @default("SENT")
  error       String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rm      User    @relation(fields: [rmUserId], references: [id], onDelete: Cascade)
  offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([rmUserId])
}

// ─────────────────────────── payment collections (Statement of Account) ───────────────────────────

enum PaymentStatus {
  DUE
  PARTIAL
  PAID
  OVERDUE
}

// One dated installment/charge for a booked deal. Generated from the booking schedule; receipts are
// recorded against it. The set of Payments for an offer IS the Statement of Account (SOA). Every
// buyer installment is expected to be paid into the project escrow account (toEscrow).
model Payment {
  id         String        @id @default(cuid())
  companyId  String
  offerId    String
  unitId     String
  order      Int
  label      String
  kind       String        @default("installment") // installment | dld | fee
  dueDate    DateTime?
  percent    Decimal?      @db.Decimal(6, 3)
  amount     Decimal       @db.Decimal(14, 2)
  paidAmount Decimal       @db.Decimal(14, 2) @default(0)
  paidAt     DateTime?
  method     String? // bank transfer | cheque | card | cash
  reference  String?
  toEscrow   Boolean       @default(true)
  status     PaymentStatus @default(DUE)
  lastReminderAt DateTime? // last automated payment-reminder email sent to the buyer
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([offerId])
  @@index([companyId, status])
}

// ─────────────────────────── EOI / launch allocation (pre-booking) ───────────────────────────

enum EoiStatus {
  SUBMITTED
  ALLOCATED
  CONVERTED
  REFUNDED
  CANCELLED
}

// An Expression of Interest — a refundable token deposit a buyer places to get priority in a launch
// allocation, before a specific unit is booked.
model Eoi {
  id           String    @id @default(cuid())
  companyId    String
  projectId    String?
  clientName   String
  clientEmail  String?
  clientPhone  String?
  clientIdNumber String?
  tokenAmount  Decimal   @db.Decimal(14, 2) @default(0)
  refundable   Boolean   @default(true)
  priority     Int       @default(0)
  status       EoiStatus @default(SUBMITTED)
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([companyId])
}
